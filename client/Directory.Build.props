<Project>
  <!-- Client version: raise on every change below client/, otherwise the management server sees no update. -->
  <PropertyGroup>
    <Version>0.3.1</Version>
    <Product>M365 SMTP Proxy</Product>
    <Company>M365 SMTP Proxy</Company>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <SatelliteResourceLanguages>de;en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
